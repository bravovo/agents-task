{
  "all": true,
  "include": [
    "src/**/*.js",
    "src/**/*.jsx"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.js",
    "**/*.test.jsx",
    "src/main.jsx",
    "cypress/**"
  ],
  "reporter": [
    "text",
    "text-summary",
    "html",
    "lcov",
    "json"
  ],
  "report-dir": "coverage-component",
  "extension": [
    ".js",
    ".jsx"
  ],
  "sourceMap": false,
  "instrument": false
}
